model User {
  id                  Int                 @id @default(autoincrement())
  fullname            String
  email               String              @unique
  password            String
  avatarUrl           String?             @map("avatar_url")
  audioStats          AudioStats[]
  audios              Audio[]
  folderShares        FolderShare[]
  folders             Folder[]
  leaderboardPoint    LeaderboardPoint?
  quizAttemptLogs     QuizAttemptLog[]
  quizStats           QuizStats[]
  userExp             UserExp[]
  mistakeQuizs        MistakeQuiz[]
  streaks             Streak[]
  userAchievements    UserAchievement[]
  quizzes             Quiz[]
  refreshTokens       RefreshToken[]
  reminders           Reminder[]
  userSettings        UserSetting[]
  userDailyActivities UserDailyActivity[]
  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expireTime DateTime @map("expire_time")
  revoked    Boolean  @default(false)
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Reminder {
  id     Int      @id @default(autoincrement())
  userId Int      @map("user_id")
  time   DateTime
  user   User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("reminders")
}

model UserSetting {
  userId                 Int      @id @map("user_id")
  allowEmailNotification Boolean  @default(true) @map("allow_email_notification")

  user                   User     @relation(fields: [userId], references: [id])
  reminderTimes          String[] @default(["20:00"])

  @@map("user_settings")
}

model UserDailyActivity {
  userId          Int      @map("user_id")
  date            DateTime @map("date")
  didListen       Boolean  @default(false) @map("did_listen")
  didQuiz         Boolean  @default(false) @map("did_quiz")
  totalListenTime Int      @default(0) @map("total_listen_time")
  user            User     @relation(fields: [userId], references: [id])

  @@id([userId, date])
  @@index([date])
  @@map("user_daily_activities")
}
